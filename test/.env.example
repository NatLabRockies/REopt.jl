# Template for the local `test/.env` file used by the REopt.jl test suite.
# Copy this file to `test/.env` and fill in your own values. `test/.env` is
# git-ignored and must never be committed.
#
# NLR developer network API key and email, used for PVWatts, Wind Toolkit, and
# CST API calls. Sign up for free at https://developer.nlr.gov/signup
NLR_DEVELOPER_API_KEY=your-nlr-developer-api-key
NLR_DEVELOPER_EMAIL=your-contact-email@example.com

# Utility Rate Database (URDB) API key, used to download URDB rates.
# Get one for free at https://openei.org/services/api/signup/
URDB_API_KEY=your-urdb-api-key
